@export
enum Direction {
    North,
    South,
    East,
    West,
}

@export
resource PlayerConfig {
    speed: float = 200.0
    jump_force: float = -400.0
    max_hp: int = 100
    key_left: Direction = Direction.North
    key_right: Direction = Direction.South
}

node body = BodyNode(player)
node input_x = InputAxis1D(Direction.North, Direction.South)
node on_hit = OnCollision(body, "hazard")
node play_sfx = PlaySound("hit.wav") on on_hit
node damage = Damage(body, 10) on on_hit, on_other
