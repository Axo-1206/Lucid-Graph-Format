-- A composite with input, output, and a body containing a resource
-- and two nodes.
composite Health {
    input { max: int }

    output {
        current:  int   = State.current
        on_death: Event = dead
    }

    resource State {
        current: int = 0
        max:     int = 0
    }

    node init  = SetOnStart(State.current, max)
    node check = LessNode(State.current, 1)
    node dead  = When(check)
}
